# Unified Loki web/research runtime. Native licensed engines remain optional.
FROM python:3.12-slim AS builder
WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && pip check

FROM python:3.12-slim
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LOKI_ENV=production
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY main.py index.py supabase_manager.py supabase_schema.sql README.md ./
COPY loki/ ./loki/
COPY loki_v8/ ./loki_v8/
COPY core/ ./core/
COPY core_engine/ ./core_engine/
COPY components/ ./components/
COPY third_party/ ./third_party/
COPY docs/ ./docs/
COPY templates/ ./templates/
COPY static/ ./static/
RUN groupadd --gid 10001 loki && useradd --uid 10001 --gid loki --create-home loki \
    && mkdir -p /app/state && chown -R loki:loki /app/state
USER loki
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/health', timeout=4)"]
EXPOSE 8000
# One worker owns the in-memory paper engine and broker-session registry.
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
