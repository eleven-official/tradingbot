NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
SUPABASE_SERVICE_KEY=sb_secret_server_only_replace
# Generate a new random secret; Vercel sends it as Authorization: Bearer.
CRON_SECRET=replace_with_at_least_32_random_characters
# Licensed market-data account, server-only. No paper/live order key is needed.
ALPACA_DATA_KEY=
ALPACA_DATA_SECRET=
# Never set this to true merely because a backtest is positive.
TRADING_ENABLED=false
# Optional shared HMAC secret for the existing Loki server, >=32 random chars.
# Both deployments must refer to the same Supabase Auth project.
LOKI_RESEARCH_BRIDGE_SECRET=
