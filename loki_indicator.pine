//@version=5
indicator("Loki - Advanced Buy/Sell Signals", overlay=true, shorttitle="Loki")

// ============================================
// LOKI - ADVANCED TRADING INDICATOR
// Multi-timeframe, ML-inspired, high-accuracy signals
// ============================================

// ================= INPUT PARAMETERS =================
// Timeframe Settings
tf1 = input.timeframe("15", "Primary Timeframe", group="Timeframe")
tf2 = input.timeframe("60", "Secondary Timeframe", group="Timeframe")
tf3 = input.timeframe("240", "Tertiary Timeframe", group="Timeframe")

// Indicator Settings
rsiPeriod = input.int(14, "RSI Period", minval=1, group="Indicators")
macdFast = input.int(12, "MACD Fast", minval=1, group="Indicators")
macdSlow = input.int(26, "MACD Slow", minval=1, group="Indicators")
macdSignal = input.int(9, "MACD Signal", minval=1, group="Indicators")
bbLength = input.int(20, "Bollinger Bands Length", minval=1, group="Indicators")
bbMult = input.float(2.0, "Bollinger Bands Multiplier", minval=0.1, group="Indicators")

// Signal Strength Settings
buyThreshold = input.int(70, "Buy Signal Strength", minval=50, maxval=100, group="Signal Settings")
sellThreshold = input.int(30, "Sell Signal Strength", minval=0, maxval=50, group="Signal Settings")
confirmTrend = input.bool(true, "Require Trend Confirmation", group="Signal Settings")

// ================= INDICATOR CALCULATIONS =================

// RSI
rsi = ta.rsi(close, rsiPeriod)
rsiOverbought = rsi > 70
rsiOversold = rsi < 30

// MACD
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdBullish = macdLine > signalLine
macdBearish = macdLine < signalLine
macdCrossUp = ta.crossover(macdLine, signalLine)
macdCrossDown = ta.crossunder(macdLine, signalLine)

// Bollinger Bands
[bbMiddle, bbUpper, bbLower] = ta.bb(close, bbLength, bbMult)
bbSqueeze = (bbUpper - bbLower) / bbMiddle < 0.1
bbBullish = close > bbMiddle
bbBearish = close < bbMiddle

// Moving Averages
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
trendUp = ema20 > ema50 and ema50 > ema200
trendDown = ema20 < ema50 and ema50 < ema200

// Volume Analysis
volSMA = ta.sma(volume, 20)
volHigh = volume > volSMA * 1.5
volBullish = volume > volSMA and close > close[1]
volBearish = volume > volSMA and close < close[1]

// ATR for Volatility
atr = ta.atr(14)
volatility = atr / close * 100
highVol = volatility > 2
lowVol = volatility < 0.5

// ================= MULTI-TIMEFRAME ANALYSIS =================

// Primary Timeframe Data
rsi1 = request.security(syminfo.tickerid, tf1, ta.rsi(close, rsiPeriod))
macd1 = request.security(syminfo.tickerid, tf1, ta.macd(close, macdFast, macdSlow, macdSignal))
[macdLine1, signalLine1, histLine1] = macd1
[bbMiddle1, bbUpper1, bbLower1] = request.security(syminfo.tickerid, tf1, ta.bb(close, bbLength, bbMult))
ema201 = request.security(syminfo.tickerid, tf1, ta.ema(close, 20))
ema501 = request.security(syminfo.tickerid, tf1, ta.ema(close, 50))

// Secondary Timeframe Data
rsi2 = request.security(syminfo.tickerid, tf2, ta.rsi(close, rsiPeriod))
[macdLine2, signalLine2, histLine2] = request.security(syminfo.tickerid, tf2, ta.macd(close, macdFast, macdSlow, macdSignal))
ema202 = request.security(syminfo.tickerid, tf2, ta.ema(close, 20))
ema502 = request.security(syminfo.tickerid, tf2, ta.ema(close, 50))

// Tertiary Timeframe Data
rsi3 = request.security(syminfo.tickerid, tf3, ta.rsi(close, rsiPeriod))
ema203 = request.security(syminfo.tickerid, tf3, ta.ema(close, 20))
ema503 = request.security(syminfo.tickerid, tf3, ta.ema(close, 50))

// ================= SIGNAL GENERATION =================

// Buy Signal Conditions
buyCondition1 = rsi < 30  // RSI oversold
buyCondition2 = macdCrossUp  // MACD bullish crossover
buyCondition3 = close < bbLower  // Price below lower BB
buyCondition4 = ema20 > ema50  // Short-term bullish
buyCondition5 = volBullish  // Volume supporting

// Sell Signal Conditions
sellCondition1 = rsi > 70  // RSI overbought
sellCondition2 = macdCrossDown  // MACD bearish crossover
sellCondition3 = close > bbUpper  // Price above upper BB
sellCondition4 = ema20 < ema50  // Short-term bearish
sellCondition5 = volBearish  // Volume supporting

// Multi-timeframe Confirmation
mtfBuy = rsi1 < 40 and rsi2 < 45 and rsi3 < 50
mtfSell = rsi1 > 60 and rsi2 > 55 and rsi3 > 50

// Trend Confirmation
trendConfirmBuy = ema201 > ema501 and ema202 > ema502
trendConfirmSell = ema201 < ema501 and ema202 < ema502

// Combined Signal Strength
buyScore = (buyCondition1 ? 1 : 0) + (buyCondition2 ? 1 : 0) + (buyCondition3 ? 1 : 0) + (buyCondition4 ? 1 : 0) + (buyCondition5 ? 1 : 0) + (mtfBuy ? 2 : 0) + (trendConfirmBuy ? 2 : 0)
sellScore = (sellCondition1 ? 1 : 0) + (sellCondition2 ? 1 : 0) + (sellCondition3 ? 1 : 0) + (sellCondition4 ? 1 : 0) + (sellCondition5 ? 1 : 0) + (mtfSell ? 2 : 0) + (trendConfirmSell ? 2 : 0)

// Final Buy/Sell Signals
strongBuy = buyScore >= buyThreshold / 10 and confirmTrend ? trendConfirmBuy : true
strongSell = sellScore >= (100 - sellThreshold) / 10 and confirmTrend ? trendConfirmSell : true

// Exit Signals
exitBuy = rsi > 70 or macdCrossDown
exitSell = rsi < 30 or macdCrossUp

// ================= PLOT SIGNALS =================

// Buy Signal
plotshape(strongBuy and buyScore[1] < buyScore / 10, title="BUY", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.normal, text="BUY")

// Sell Signal
plotshape(strongSell and sellScore[1] < (100 - sellThreshold) / 10, title="SELL", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.normal, text="SELL")

// Exit Long Signal
plotshape(exitBuy and strongBuy[1], title="EXIT LONG", location=location.abovebar, color=color.orange, style=shape.xcross, size=size.small, text="EXIT")

// Exit Short Signal
plotshape(exitSell and strongSell[1], title="EXIT SHORT", location=location.belowbar, color=color.orange, style=shape.xcross, size=size.small, text="EXIT")

// ================= PLOT INDICATORS =================

// Moving Averages
plot(ema20, color=color.blue, linewidth=2, title="EMA 20")
plot(ema50, color=color.orange, linewidth=2, title="EMA 50")
plot(ema200, color=color.purple, linewidth=2, title="EMA 200")

// Bollinger Bands
p1 = plot(bbUpper, color=color.gray, linewidth=1, title="BB Upper")
p2 = plot(bbLower, color=color.gray, linewidth=1, title="BB Lower")
fill(p1, p2, color=color.new(color.gray, 90), title="BB Fill")

// ================= SIGNAL STRENGTH DISPLAY =================

// Signal Strength Background
bgcolor(strongBuy ? color.new(color.green, 90) : strongSell ? color.new(color.red, 90) : na, title="Signal Background")

// ================= ALERTS =================

alertcondition(strongBuy and buyScore[1] < buyScore / 10, title="Strong BUY Signal", message="Loki BUY Signal: {{ticker}} @ {{close}} | Score: {{buyScore}}")
alertcondition(strongSell and sellScore[1] < (100 - sellThreshold) / 10, title="Strong SELL Signal", message="Loki SELL Signal: {{ticker}} @ {{close}} | Score: {{sellScore}}")
alertcondition(exitBuy and strongBuy[1], title="Exit LONG Position", message="Loki Exit LONG: {{ticker}} @ {{close}}")
alertcondition(exitSell and strongSell[1], title="Exit SHORT Position", message="Loki Exit SHORT: {{ticker}} @ {{close}}")

// ================= INFORMATION TABLE =================

var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, "Loki Signal", text_color=color.white, text_size=size.normal)
    table.cell(infoTable, 1, 0, strongBuy ? "STRONG BUY" : strongSell ? "STRONG SELL" : "NEUTRAL", text_color=strongBuy ? color.green : strongSell ? color.red : color.yellow, text_size=size.normal)
    
    table.cell(infoTable, 0, 1, "Buy Score", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(buyScore, "#"), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 2, "Sell Score", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(sellScore, "#"), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 3, "RSI", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(rsi, "#.##"), text_color=rsi > 70 ? color.red : rsi < 30 ? color.green : color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 4, "Trend", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, trendUp ? "BULLISH" : trendDown ? "BEARISH" : "NEUTRAL", text_color=trendUp ? color.green : trendDown ? color.red : color.yellow, text_size=size.small)
    
    table.cell(infoTable, 0, 5, "Volatility", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(volatility, "#.##") + "%", text_color=highVol ? color.red : lowVol ? color.green : color.white, text_size=size.small)

// ================= STOP LOSS & TAKE PROFIT =================

// ATR-based Stop Loss
atrSL = atr * 2
longSL = close - atrSL
shortSL = close + atrSL

// ATR-based Take Profit
atrTP = atr * 3
longTP = close + atrTP
shortTP = close - atrTP

// Plot Stop Loss and Take Profit
plot(strongBuy ? longSL : na, color=color.red, style=plot.style_linebr, linewidth=1, title="Long Stop Loss")
plot(strongBuy ? longTP : na, color=color.green, style=plot.style_linebr, linewidth=1, title="Long Take Profit")
plot(strongSell ? shortSL : na, color=color.red, style=plot.style_linebr, linewidth=1, title="Short Stop Loss")
plot(strongSell ? shortTP : na, color=color.green, style=plot.style_linebr, linewidth=1, title="Short Take Profit")

// ================= POSITION SIZE CALCULATION =================

// Risk-based position sizing (1% risk per trade)
riskPercent = input.float(1.0, "Risk Percent", minval=0.1, maxval=10.0, group="Risk Management")
accountValue = input.float(10000, "Account Value ($)", minval=100, group="Risk Management")

positionSize = (accountValue * riskPercent / 100) / atrSL
lots = positionSize / close

// Display position size in table if in position
if barstate.islast and (strongBuy or strongSell)
    table.cell(infoTable, 0, 6, "Position Size", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, str.tostring(lots, "#.####") + " lots", text_color=color.white, text_size=size.small)