# Example environment variables for tradingbot
# Copy to .env and fill your real keys locally. NEVER commit real keys to the repo.

# Enable live trading in-process (server): set to "true" only if you know what you're doing
# This is intentionally separate from ALLOW_LIVE which protects remote toggles
LIVE_TRADING=false

# Safety override: if ALLOW_LIVE is not true, the dashboard endpoint won't enable live trading remotely
ALLOW_LIVE=false

# Binance (crypto) API keys (use only if you intend to trade on Binance)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Alpaca (stocks) API keys (example)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Other broker keys can be placed here. We recommend using environment variables on the server and not storing in files.
