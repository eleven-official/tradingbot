# Quantum Trading Bot - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# EXCHANGE API KEYS
# ============================================
# Primary Exchange (Binance)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# Free Alpaca Paper Trading (paper keys only; used by config.alpaca_paper.yaml)
ALPACA_PAPER_API_KEY=your_alpaca_paper_key_id_here
ALPACA_PAPER_API_SECRET=your_alpaca_paper_secret_here

# Protects incoming TradingView alerts. Use a long random value and never
# place it in source control. Loki will refuse authenticated execution without it.
TRADINGVIEW_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Backup Exchange (Bybit)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Backup Exchange (Kraken)
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# ============================================
# TRADINGVIEW MCP
# ============================================
TRADINGVIEW_API_KEY=your_tradingview_api_key_here
TRADINGVIEW_SERVER_URL=ws://localhost:8080

# ============================================
# TRADING CONFIGURATION
# ============================================
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT,ADAUSDT,SOLUSDT
MAX_POSITIONS=5
POSITION_SIZE_PERCENT=0.02
MAX_RISK_PER_TRADE=0.01
GLOBAL_RISK_LIMIT=0.05
BASE_CURRENCY=AUD

# ============================================
# NEURAL MUTATION
# ============================================
GENETIC_OPTIMIZER_ENABLED=true
POPULATION_SIZE=50
MUTATION_RATE=0.1
SELECTION_PRESSURE=0.7
EVOLUTION_INTERVAL_HOURS=1

# ============================================
# BACKTESTING
# ============================================
SHADOW_BACKTEST_ENABLED=true
SHADOW_COUNT=10
LOOKBACK_DAYS=30
MIN_TRADES_REQUIRED=20
DEGRADATION_THRESHOLD=0.2

# ============================================
# TOXICITY FILTER
# ============================================
VPIN_FILTER_ENABLED=true
VPIN_THRESHOLD=0.3
IMBALANCE_THRESHOLD=0.6
FREEZE_DURATION_MINUTES=5

# ============================================
# SMART ORDER ROUTING
# ============================================
SOR_ENABLED=true
ICEBERG_SLICES=10
RANDOMIZE_VENUES=true
MIN_ORDER_SIZE=0.001

# ============================================
# RISK TOPOLOGY
# ============================================
KELLY_ALLOCATOR_ENABLED=true
VAR_ENABLED=true
CIRCUIT_BREAKER_ENABLED=true
MAX_DRAWDOWN_PERCENT=10.0
HOURLY_LOSS_LIMIT_PERCENT=2.0
EMERGENCY_KILL_ENABLED=true

# ============================================
# DASHBOARD
# ============================================
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080
DASHBOARD_UPDATE_INTERVAL=1

# ============================================
# CHAOS TESTING
# ============================================
CHAOS_TESTING_ENABLED=true
CHAOS_INTERVAL_HOURS=24
BLACK_SWAN_SCENARIOS=liquidity_evaporation,api_latency,flash_crash

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=quantum_trading.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite:///quantum_trading.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# SUPABASE
# ============================================
# Get these from your Supabase project: Dashboard → Project Settings → API
SUPABASE_URL=https://vwtmfsrcqyteviyniiqj.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ============================================
# NOTIFICATIONS
# ============================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=your_slack_webhook_url

EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# ============================================
# SYSTEM
# ============================================
TIMEZONE=Australia/Sydney
STARTUP_MODE=headless
AUTO_RESTART=true
MAX_RESTART_ATTEMPTS=3
