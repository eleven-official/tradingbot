//@version=5
// ═══════════════════════════════════════════════════════════════════════════════
//  LOKI — NQ Structural KNN / Adaptive Predictive Engine  ·  Neon Edition
//  ─────────────────────────────────────────────────────────────────────────────
//  Hardened edition: exact-horizon labels, rolling audit, closed-bar HUD.
//   • Features read CLOSED bars only: body/wick anatomy, range expansion vs
//     ATR, a 1/3/5 momentum ladder in ATR units, volume pressure, and position
//     inside the 20-bar structural envelope — all z-scored over 200 bars.
//   • Every confirmed bar stores its condition vector into a bounded FIFO library.
//     HORIZON bars later, the close labels that sample (+1/−1/0).
//   • Each closed bar uses log(1 + absolute difference) Lorentz-distance
//     KNN votes over the labeled library → pLong/pShort/conf (vote shares).
//   • Vote shaping: neighbors vote distance-softened (1/(0.5+d)) with optional
//     recency decay; a winning pool must also clear a margin % over the loser.
//   • Entries align with confirmed pivot structure unless confidence pays an
//     extra bump; a cooldown follows exits before the next entry may fire.
//   • Signals (Go Long / Go Short / Exit) fire only on confirmed bars, frozen
//     at print time — no repaint.
//   • TP/SL are ATR multiples drawn from entry; S/R from pivots with lookahead off.
//   • A FIFO audit resolves fired signals HORIZON bars after fire → rolling
//     win-rate and an ATR-normalized rolling expectancy.
//   • alert() payloads fire once per bar close with frozen values.
//
//  Neon display:
//   • Four neon themes (Midnight · Cyberpunk · Sunset · Aurora) + custom accents.
//   • Choice of candle coloring: structural (colored conservatively: by bias
//     with fading tails, not by literal up/down) or market-accurate candle fill.
//   • Glow pulse on momentum ladders & brackets (layered transparency bands).
//   • Interface: closed-bar neon HUD with inline confidence bars.
//   • Multi-layer support/resistance bands filled with theme-tinted gradients.
//
//  Honest scope: this is a probabilistic research tool. Vote share is model
//  confidence, not guaranteed probability — the HUD's win-rate row reports
//  exactly what resolved signals did. Audit it before trusting anything.
// ═══════════════════════════════════════════════════════════════════════════════
indicator("Loki — NQ Structural KNN · Neon", shorttitle="LOKI✦", overlay=true,
     max_labels_count=100, max_lines_count=20)

// ─────────────────────────────── INPUTS ─────────────────────────────────────
grpModel  = "⟡ KNN engine"
lookback  = input.int(1500, "Training window (bars)", minval=200, maxval=3000,
     group=grpModel, tooltip="Closed bars kept as the KNN library.")
knn       = input.int(10, "Neighbors (k)", minval=3, maxval=25, group=grpModel)
horizon   = input.int(3, "Outcome horizon (closed bars)", minval=1, maxval=10, group=grpModel)

grpFeat   = "✧ Feature weights"
w_body    = input.float(1.0, "Body ratio",      minval=0, step=0.25, group=grpFeat)
w_wick    = input.float(1.0, "Wick asymmetry",  minval=0, step=0.25, group=grpFeat)
w_range   = input.float(1.0, "Range expansion", minval=0, step=0.25, group=grpFeat)
w_momo    = input.float(1.0, "Momentum ladder", minval=0, step=0.25, group=grpFeat)
w_vol     = input.float(1.0, "Volume pressure", minval=0, step=0.25, group=grpFeat)
w_struct  = input.float(1.5, "Range position",  minval=0, step=0.25, group=grpFeat)

grpVote   = "⟐ Vote shaping"
useWeights= input.bool(true, "Closest neighbor counts double+", group=grpVote,
     tooltip="Extra confidence requirement: poll honest shifts. Neighbors vote with distance-softened weights (1/(0.5+d)) and optional recency decay; flat counts still gate the minimum support.")
decayHalf = input.int(90, "Recency half-life (bars, 0=off)", minval=0, maxval=1500, group=grpVote,
     tooltip="Library entries older than several half-lives fade toward zero influence. 0 disables decay.")
marginMin = input.float(18.0, "Min margin % between vote pools", minval=0, maxval=50, step=2, group=grpVote, tooltip="Winning pool must beat the losing pool by this share of total vote weight, on top of the confidence floor — keeps unbalanced slop out.")
alignGate = input.bool(true, "Align entries with market structure", group=grpVote,
     tooltip="A long needs structure-up (break of the last confirmed pivot high) unless confidence clears an extra bump; mirrored for shorts.")
ctBump    = input.float(10.0, "Counter-trend extra confidence %", minval=0, maxval=25, step=1, group=grpVote)
coolBars  = input.int(6, "Cooldown after exit (bars)", minval=0, maxval=120, group=grpVote,
     tooltip="No re-entries while the cooldown runs after an exit. Reversals are active signals, they still fire.")

grpGates  = "⚑ Signal gates"
confMin   = input.float(62.0, "Confidence floor", minval=50.0, maxval=90.0, step=1.0, group=grpGates)
rngMin    = input.float(0.55, "Min range / ATR",  minval=0.2, step=0.05, group=grpGates)
useSession= input.bool(true, "Trade NQ cash hours only", group=grpGates)
sessDef   = input.session("0930-1600", "Session", group=grpGates)

grpLevels = "◈ Targets and levels"
atrLen    = input.int(20, "ATR length", minval=5, group=grpLevels)
tpMult    = input.float(2.0,  "TP = ATR ×", minval=0.25, step=0.25, group=grpLevels)
slMult    = input.float(1.25, "SL = ATR ×", minval=0.25, step=0.25, group=grpLevels)
srTF      = input.timeframe("15", "S/R resolution", group=grpLevels)
pivLeft   = input.int(5, "Pivot left bars",  minval=1, group=grpLevels)
pivRight  = input.int(5, "Pivot right bars", minval=1, group=grpLevels)

grpStats  = "▸ Signal audit"
statLen   = input.int(30, "Rolling audit size", minval=10, maxval=200, group=grpStats)

grpStyle  = "✦ Neon cosmetics"
themeSel = input.string("Midnight", "Theme",
     options=["Midnight", "Cyberpunk", "Sunset", "Aurora", "Custom"], group=grpStyle)
cBullCust = input.color(color.new(#00ffa3, 0), "Custom ▲", inline="tc", group=grpStyle)
cBearCust = input.color(color.new(#ff4d6d, 0), "Custom ▼", inline="tc", group=grpStyle)
cAccCust  = input.color(color.new(#3ad0ff, 0), "Custom ✦", inline="tc", group=grpStyle)

paintModel = input.string("market", "Candle ghosting",
     options=["market", "bias ghost"], group=grpStyle,
     tooltip="market = real candles untouched. bias ghost = candles painted with the model's live bias (visual only, does NOT change data).")
trailGlow  = input.bool(true, "Momentum trail glow (layered)", group=grpStyle)
glowBands  = input.bool(true, "S/R gradient bands", group=grpStyle)
showSig    = input.bool(true, "Signal labels", group=grpStyle)
showHUD    = input.bool(true, "HUD dashboard", group=grpStyle)
hudSize    = input.string("small", "HUD text size", options=["tiny", "small", "normal"], group=grpStyle)

// ───────────────────────────── THEME PALETTE ────────────────────────────────
// Real theme palette: one source of color truth for bars, lines, HUD, badges,
// and candle ghosts. All plots stay series-colored — no hardcoded passes.
themeUp    = themeSel == "Midnight"  ? color.new(#00ffa3, 0) :
     themeSel == "Cyberpunk" ? color.new(#c77dff, 0) :
     themeSel == "Sunset"    ? color.new(#ff9e57, 0) :
     themeSel == "Aurora"    ? color.new(#7ef9c8, 0) : cBullCust
themeDown  = themeSel == "Midnight"  ? color.new(#ff4d6d, 0) :
     themeSel == "Cyberpunk" ? color.new(#ff2bd6, 0) :
     themeSel == "Sunset"    ? color.new(#e63946, 0) :
     themeSel == "Aurora"    ? color.new(#fd5ea0, 0) : cBearCust
themeAcc   = themeSel == "Midnight"  ? color.new(#3ad0ff, 0) :
     themeSel == "Cyberpunk" ? color.new(#00e5ff, 0) :
     themeSel == "Sunset"    ? color.new(#ffd166, 0) :
     themeSel == "Aurora"    ? color.new(#a0c4ff, 0) : cAccCust
themeDim   = color.new(color.gray, 0)
themeBG    = themeSel == "Cyberpunk" ? color.new(#120a1f, 75) :
     themeSel == "Sunset" ? color.new(#1a0f14, 75) :
     themeSel == "Aurora" ? color.new(#0a141a, 75) : color.new(color.black, 75)

C_BULL = themeUp
C_BEAR = themeDown
C_FLAT = themeDim
C_ACC  = themeAcc
C_BG   = themeBG

// ─────────────────────── FEATURE EXTRACTION (CLOSED BAR ONLY) ───────────────
body = math.abs(close - open)
rng  = high - low
rngSafe = math.max(rng, syminfo.mintick)

atr  = ta.atr(atrLen)
atrSafe = math.max(atr, syminfo.mintick)

f_body  = body / rngSafe
f_wick  = ((high - math.max(open, close)) - (math.min(open, close) - low)) / rngSafe
f_range = rngSafe / atrSafe
f_m1 = (close - close[1]) / atrSafe
f_m3 = (close - close[3]) / atrSafe
f_m5 = (close - close[5]) / atrSafe
f_vol = volume / math.max(ta.sma(volume, 20), 1)
hi20 = ta.highest(high, 20)
lo20 = ta.lowest(low, 20)
f_struct = (close - lo20) / math.max(hi20 - lo20, syminfo.mintick)

zSize = 200
zdef(s) =>
    m = ta.sma(s, zSize)
    sd = ta.stdev(s, zSize)
    sd > 0 ? math.max(-5.0, math.min(5.0, (s - m) / sd)) : 0.0

dq = array.from(
     w_body   * zdef(f_body),
     w_wick   * zdef(f_wick),
     w_range  * zdef(f_range),
     w_momo   * zdef(f_m1),
     w_momo   * zdef(f_m3),
     w_momo   * zdef(f_m5),
     w_vol    * zdef(f_vol),
     w_struct * zdef(f_struct)
)
nFeat = array.size(dq)

// Cash hours are New York time, not the futures exchange's Chicago clock.
sessOK = not useSession or not na(time(timeframe.period, sessDef + ":23456", "America/New_York"))
featuresReady = bar_index >= zSize + 20 and not na(atr) and not na(f_vol)

// ─────────────────────────── MARKET STRUCTURE STATE ─────────────────────────
ph = ta.pivothigh(high, pivLeft, pivRight)
pl = ta.pivotlow(low, pivLeft, pivRight)
var float lastPH = na
var float lastPL = na
if barstate.isconfirmed and not na(ph)
    lastPH := ph
if barstate.isconfirmed and not na(pl)
    lastPL := pl

structUp = not na(lastPH) and not na(lastPL) and close > lastPH and lastPH > lastPL
structDn = not na(lastPH) and not na(lastPL) and close < lastPL and lastPL < lastPH

regimeV = atr / math.max(ta.sma(atr, 50), syminfo.mintick)
regime = structUp ? "UP-TREND" :
     structDn ? "DOWN-TREND" :
     regimeV > 1.15 ? "CHOP · VOL↑" :
     regimeV < 0.85 ? "QUIET" : "RANGE"
regimeColor = structUp ? C_BULL : structDn ? C_BEAR : C_FLAT

// ─────────────────────── KNN MEMORY (FIFO, BOUNDED) ─────────────────────────
var float[] sampleF = array.new_float(0)
var float[] sampleR = array.new_float(0)
var int[]   sampleL = array.new_int(0)
var int[]   sampleB = array.new_int(0)

if barstate.isconfirmed
    // Before appending, the last element represents the preceding bar.
    idx = array.size(sampleL) - horizon
    if idx >= 0
        if bar_index - array.get(sampleB, idx) == horizon
            ref = array.get(sampleR, idx)
            dir = close > ref ? 1 : close < ref ? -1 : 0
            array.set(sampleL, idx, dir)
    if featuresReady
        for j = 0 to nFeat - 1
            array.push(sampleF, array.get(dq, j))
        array.push(sampleR, close)
        array.push(sampleL, 0)
        array.push(sampleB, bar_index)
        if array.size(sampleL) > lookback
            for _i = 1 to nFeat
                array.shift(sampleF)
            array.shift(sampleR)
            array.shift(sampleL)
            array.shift(sampleB)

// ─────────────────────────── KNN CLASSIFICATION ─────────────────────────────
scoreBar() =>
    n = array.size(sampleL)
    if n >= 50
        bestD = array.new_float(knn, 1.0e12)
        bestL = array.new_int(knn, 0)
        bestI = array.new_int(knn, -1)
        start = math.max(0, n - lookback)
        for i = start to n - 1
            lab = array.get(sampleL, i)
            if lab != 0
                off = i * nFeat
                d = 0.0
                for j = 0 to nFeat - 1
                    d += math.log(1.0 + math.abs(array.get(dq, j) - array.get(sampleF, off + j)))
                if d < array.get(bestD, knn - 1)
                    slot = knn - 1
                    // Pine v5 does not guarantee short-circuit evaluation.
                    while slot > 0
                        if d >= array.get(bestD, slot - 1)
                            break
                        array.set(bestD, slot, array.get(bestD, slot - 1))
                        array.set(bestL, slot, array.get(bestL, slot - 1))
                        array.set(bestI, slot, array.get(bestI, slot - 1))
                        slot -= 1
                    array.set(bestD, slot, d)
                    array.set(bestL, slot, lab)
                    array.set(bestI, slot, i)
        up = 0
        dn = 0
        wUp = 0.0
        wDn = 0.0
        dSum = 0.0
        for t = 0 to knn - 1
            lab = array.get(bestL, t)
            if lab != 0
                dNei = array.get(bestD, t)
                wNei = useWeights ? 1.0 / (0.5 + dNei) : 1.0
                idxNei = array.get(bestI, t)
                if decayHalf > 0 and idxNei >= 0
                    // Fresher library entries carry more pull (age in bars).
                    age = bar_index - array.get(sampleB, idxNei)
                    wNei *= age > 0 ? math.pow(0.5, age / decayHalf) : 1.0
                if lab > 0
                    up += 1
                    wUp += wNei
                else
                    dn += 1
                    wDn += wNei
                dSum += dNei
        [up, dn, wUp, wDn, dSum / knn]
    else
        [0, 0, 0.0, 0.0, 0.0]

var int upN = 0
var int dnN = 0
var float wUpN = 0.0
var float wDnN = 0.0
var float dMean = 0.0
if barstate.isconfirmed
    [closedUp, closedDown, closedWUp, closedWDn, closedD] = scoreBar()
    upN := closedUp
    dnN := closedDown
    wUpN := closedWUp
    wDnN := closedWDn
    dMean := closedD
total = upN + dnN
wTotal = wUpN + wDnN
pLong  = wTotal > 0 ? 100.0 * wUpN / wTotal : 50.0
pShort = 100.0 - pLong
conf   = math.max(pLong, pShort)
margin = wTotal > 0 ? 100.0 * math.abs(wUpN - wDnN) / wTotal : 0.0

confOK = featuresReady and conf >= confMin and margin >= marginMin and total >= math.max(3, math.floor(knn * 0.6))
bias = pLong > 50 ? 1 : pLong < 50 ? -1 : 0

// ────────────────────── SIGNAL STATE MACHINE (LOCKED AT CLOSE) ──────────────
rngOK = f_range >= rngMin
// Counter-trend entries need extra confidence when the alignment gate is on.
alignsLong  = not alignGate or structUp or conf >= confMin + ctBump
alignsShort = not alignGate or structDn or conf >= confMin + ctBump
var int quietUntil = 0
cooling = bar_index < quietUntil
longCond  = barstate.isconfirmed and sessOK and rngOK and confOK and alignsLong  and bias > 0 and not cooling
shortCond = barstate.isconfirmed and sessOK and rngOK and confOK and alignsShort and bias < 0 and not cooling

var int state = 0
var int lastState = 0
if barstate.isconfirmed
    if longCond
        state := 1
    else if shortCond
        state := -1
    else
        state := 0

evLong  = barstate.isconfirmed and state == 1  and lastState != 1
evShort = barstate.isconfirmed and state == -1 and lastState != -1
evExit  = barstate.isconfirmed and state == 0  and lastState != 0
if barstate.isconfirmed
    lastState := state
    if evExit
        quietUntil := bar_index + coolBars

// ─────────────────────── AUDIT: RESOLVED SIGNAL WIN-RATE ────────────────────
var float[] auditDir = array.new_float(0)
var float[] auditPx  = array.new_float(0)
var int[]   auditB   = array.new_int(0)
var int   auditN = 0
var int   auditW = 0
var int[] auditResults = array.new_int(0)
var float[] auditExp = array.new_float(0)

if barstate.isconfirmed
    if evLong
        array.push(auditDir, 1.0)
        array.push(auditPx, close)
        array.push(auditB, bar_index)
    else if evShort
        array.push(auditDir, -1.0)
        array.push(auditPx, close)
        array.push(auditB, bar_index)
    while array.size(auditDir) > 0
        if bar_index - array.get(auditB, 0) < horizon
            break
        dirF = array.get(auditDir, 0)
        moved = close - array.get(auditPx, 0)
        // Flat outcomes count as non-wins, not discarded observations.
        won = (dirF > 0 and moved > 0) or (dirF < 0 and moved < 0)
        array.push(auditResults, won ? 1 : 0)
        if array.size(auditResults) > statLen
            array.shift(auditResults)
        auditN := array.size(auditResults)
        auditW := array.sum(auditResults)
        // ATR-normalized signed outcome for the rolling expectancy row.
        array.push(auditExp, (dirF > 0 ? 1.0 : -1.0) * moved / atrSafe)
        if array.size(auditExp) > statLen
            array.shift(auditExp)
        array.shift(auditDir)
        array.shift(auditPx)
        array.shift(auditB)
    if array.size(auditDir) > statLen
        array.shift(auditDir)
        array.shift(auditPx)
        array.shift(auditB)

winRate = auditN > 0 ? 100.0 * auditW / auditN : na
expMean = array.size(auditExp) > 0 ? array.avg(auditExp) : na

// ─────────────────────────── TP / SL TARGET LINES ───────────────────────────
var line tpLine = na
var line slLine = na
var line enLine = na
var linefill tpf = na
var linefill slf = na
var float entryPx = na
var float tpPx = na
var float slPx = na
var int entryBar = na
var int bracketSide = 0
var bool bracketLive = false
bool tpHit = false
bool slHit = false
bool ambiguousHit = false

if barstate.isconfirmed
    // Resolve the OLD bracket before processing a reversal at this close.
    // Entry-bar extremes occurred before the close and cannot hit a new bracket.
    if bracketLive and bar_index > entryBar
        tpHit := bracketSide == 1 ? high >= tpPx : low <= tpPx
        slHit := bracketSide == 1 ? low <= slPx : high >= slPx
        ambiguousHit := tpHit and slHit
        if tpHit or slHit
            bracketLive := false
    if not na(tpLine) and (bracketLive or tpHit or slHit or evExit)
        line.set_x2(tpLine, bar_index)
        line.set_x2(slLine, bar_index)
        line.set_x2(enLine, bar_index)
    if evExit
        bracketLive := false
    if evLong or evShort
        linefill.delete(tpf)
        linefill.delete(slf)
        line.delete(tpLine)
        line.delete(slLine)
        line.delete(enLine)
        bracketSide := evLong ? 1 : -1
        entryBar := bar_index
        entryPx := close
        tpPx := math.round_to_mintick(close + bracketSide * tpMult * atr)
        slPx := math.round_to_mintick(close - bracketSide * slMult * atr)
        bracketLive := true
        tpLine := line.new(bar_index, tpPx, bar_index + 1, tpPx, color=C_BULL, width=2, style=line.style_dashed)
        slLine := line.new(bar_index, slPx, bar_index + 1, slPx, color=C_BEAR, width=1, style=line.style_dotted)
        enLine := line.new(bar_index, close, bar_index + 1, close, color=C_ACC, width=1)
        tpf := linefill.new(tpLine, enLine, color.new(C_BULL, 88))
        slf := linefill.new(slLine, enLine, color.new(C_BEAR, 92))

// ───────────────────── CANDLE GHOSTING (bias ghost, visual only) ────────────
// When "bias ghost": candles carry the model's structural stance. Data stays
// real; only the paint changes. Colors follow the frozen state, not the bar.
barcol = paintModel == "bias ghost" ?
     (state == 1 ? color.new(C_BULL, 12) :
      state == -1 ? color.new(C_BEAR, 12) : color.new(C_FLAT, 55)) :
     na
barcolor(barcol, title="Candle ghost")
plotcandle(paintModel == "bias ghost" ? open : na,
     paintModel == "bias ghost" ? high : na,
     paintModel == "bias ghost" ? low : na,
     paintModel == "bias ghost" ? close : na,
     "Ghost fill", color=color.new(color.black, 100),
     wickcolor=barcol, bordercolor=barcol)

// ─────────────────── MOMENTUM TRAIL (glow layered plots) ────────────────────
// A soft structural trail: distance of close from the structural envelope
// center, painted in theme accent with layered transparency for glow. This is
// a VISUAL aid, and every layer's value derives from closed bars.
var float trailVal = na
if barstate.isconfirmed
    trailVal := (hi20 + lo20) / 2.0
plot(trailGlow ? trailVal : na, "Trail glow 4", color=color.new(C_ACC, 92), linewidth=6)
plot(trailGlow ? trailVal : na, "Trail glow 3", color=color.new(C_ACC, 86), linewidth=4)
plot(trailGlow ? trailVal : na, "Trail glow 2", color=color.new(C_ACC, 78), linewidth=3)
plot(trailGlow ? trailVal : na, "Trail core",  color=color.new(C_ACC, 55), linewidth=2)

// ───────────────────── S/R BANDS (lookahead off, gradient fill) ─────────────
srHigh = request.security(syminfo.tickerid, srTF, ta.pivothigh(high, pivLeft, pivRight), lookahead=barmerge.lookahead_off)
srLow  = request.security(syminfo.tickerid, srTF, ta.pivotlow(low, pivLeft, pivRight),    lookahead=barmerge.lookahead_off)
if barstate.isfirst and (not timeframe.isintraday or timeframe.in_seconds(srTF) < timeframe.in_seconds() or timeframe.in_seconds(srTF) % timeframe.in_seconds() != 0)
    runtime.error("Use an intraday chart; S/R resolution must be an equal or higher whole multiple of the chart timeframe.")
// Commit only at the requested timeframe's closing boundary. Developing
// higher-timeframe pivots must not leak into persistent levels or the HUD.
srClosed = barstate.isconfirmed and time_close == time_close(srTF)
var float resLvl = na
var float supLvl = na
if srClosed and not na(srHigh)
    resLvl := srHigh
if srClosed and not na(srLow)
    supLvl := srLow

resP = plot(resLvl, "Resistance", color=color.new(C_BEAR, 25), style=plot.style_linebr, linewidth=1)
supP = plot(supLvl, "Support",    color=color.new(C_BULL, 25), style=plot.style_linebr, linewidth=1)
// faint glow shadow just outside each level for the neon band effect
resG = plot(glowBands ? resLvl * 1.0005 : na, "Resistance glow", color=color.new(C_BEAR, 85), style=plot.style_linebr, linewidth=4)
supG = plot(glowBands ? supLvl * 0.9995 : na, "Support glow",    color=color.new(C_BULL, 85), style=plot.style_linebr, linewidth=4)
fill(resP, resG, color=color.new(C_BEAR, 92), title="Resistance band")
fill(supP, supG, color=color.new(C_BULL, 92), title="Support band")

// ─────────────────────────── OVERLAY SIGNALS ────────────────────────────────
plotshape(evLong,  style=shape.triangleup,   location=location.belowbar, color=C_BULL, size=size.small, title="Go Long")
plotshape(evShort, style=shape.triangledown, location=location.abovebar, color=C_BEAR, size=size.small, title="Go Short")
plotshape(evExit,  style=shape.xcross,       location=location.belowbar, color=C_FLAT, size=size.tiny, title="Exit")
plot(bracketLive ? entryPx : na, "Entry line", color=C_ACC, linewidth=1, style=plot.style_linebr)

// session shading with the theme's soft banner
bgcolor(sessOK ? na : color.new(color.yellow, 92), title="Session shading")
// subtle theme halo behind active positions
bgcolor(state == 1 ? color.new(C_BULL, 94) :
     state == -1 ? color.new(C_BEAR, 94) : na, title="Position halo")

if showSig and barstate.isconfirmed
    if evLong
        label.new(bar_index, low, "LOKI ▲ LONG  " + str.tostring(conf, "#.0") + "% · M" + str.tostring(margin, "#"),
             style=label.style_label_up, color=color.new(C_BULL, 15), textcolor=color.black, yloc=yloc.belowbar)
    if evShort
        label.new(bar_index, high, "LOKI ▼ SHORT  " + str.tostring(conf, "#.0") + "% · M" + str.tostring(margin, "#"),
             style=label.style_label_down, color=color.new(C_BEAR, 15), textcolor=color.white, yloc=yloc.abovebar)
    if evExit
        label.new(bar_index, close, "LOKI ■ EXIT", style=label.style_none,
             color=color.new(C_FLAT, 40), textcolor=C_FLAT, yloc=yloc.abovebar)

// ──────────────────────────── HUD (NEON) ───────────────────────────────────
hudSz = hudSize == "tiny" ? size.tiny : hudSize == "normal" ? size.normal : size.small
// inline bar writer: e.g. ████████░░░░ 8/12
barGlyph(filled, width) =>
    filledCnt = math.max(0, math.min(width, math.round(filled * width / 100.0)))
    str.repeat("█", filledCnt) + str.repeat("░", width - filledCnt)

var table hud = table.new(position.top_right, 2, 13, bgcolor=C_BG, frame_width=2,
     frame_color=color.new(C_ACC, 40), border_color=color.new(C_ACC, 80), border_width=1)

if showHUD and (barstate.islastconfirmedhistory or (barstate.islast and barstate.isconfirmed))
    table.cell(hud, 0, 0, "✦ LOKI ✦", text_color=color.new(C_ACC, 0), text_size=hudSz,
         bgcolor=color.new(color.black, 20), text_halign=text.align_center)
    table.cell(hud, 1, 0, "NQ · " + themeSel + " · KNN-" + str.tostring(knn),
         text_color=C_ACC, text_size=hudSz, bgcolor=color.new(color.black, 20), text_halign=text.align_center)
    // regime with emoji glyph
    regimeGlyph = structUp ? "🡅" : structDn ? "🡇" : "◎"
    table.cell(hud, 0, 1, "Regime", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 1, regimeGlyph + " " + regime, text_color=regimeColor, text_size=hudSz)
    // confidence meter
    confPercent = math.round(conf)
    meter = barGlyph(confPercent, 10)
    confColx = confOK ? (bias > 0 ? C_BULL : bias < 0 ? C_BEAR : C_FLAT) : C_FLAT
    table.cell(hud, 0, 2, "Confidence", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 2, str.tostring(conf, "#.0") + "%   " + meter + "  (" + str.tostring(upN) + "↑/" + str.tostring(dnN) + "↓)",
         text_color=confColx, text_size=hudSz)
    // recommended bias with colored background when a signal is live
    biasTxt = state == 1 ? "▲ LONG" : state == -1 ? "▼ SHORT" : "◐ NEUTRAL"
    biasBg = state == 1 ? color.new(C_BULL, 80) : state == -1 ? color.new(C_BEAR, 80) : color.new(C_FLAT, 88)
    biasCol = state == 1 ? color.new(C_BULL, 5) : state == -1 ? color.new(C_BEAR, 5) : C_FLAT
    table.cell(hud, 0, 3, "Bias", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 3, biasTxt, text_color=biasCol, text_size=hudSz, bgcolor=biasBg)
    // targets
    tpShow = bracketLive ? tpPx : na
    slShow = bracketLive ? slPx : na
    table.cell(hud, 0, 4, "TP / SL", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 4,
         (na(tpShow) ? "—" : str.tostring(tpShow, format.mintick)) + " / " +
         (na(slShow) ? "—" : str.tostring(slShow, format.mintick)), text_color=color.white, text_size=hudSz)
    // ATR context with regime bar
    regimeMeter = barGlyph(math.min(regimeV * 50.0, 100), 8)
    table.cell(hud, 0, 5, "ATR(" + str.tostring(atrLen) + ")", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 5, str.tostring(atr, format.mintick) + "  " + regimeMeter, text_color=color.white, text_size=hudSz)
    // measured S/R with glyph markers
    table.cell(hud, 0, 6, "Resistance", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 6, na(resLvl) ? "—" : "▲ " + str.tostring(resLvl, format.mintick), text_color=C_BEAR, text_size=hudSz)
    table.cell(hud, 0, 7, "Support", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 7, na(supLvl) ? "—" : "▼ " + str.tostring(supLvl, format.mintick), text_color=C_BULL, text_size=hudSz)
    // audit winrate with mini meter
    wrShow = auditN >= 5 ?
         str.tostring(winRate, "#.0") + "% " + barGlyph(winRate, 10) + " (" + str.tostring(auditW) + "/" + str.tostring(auditN) + ")" :
         "warming…" + str.repeat("·", 3)
    wrCol = auditN >= 5 ? (winRate >= 50 ? C_BULL : C_BEAR) : C_FLAT
    table.cell(hud, 0, 8, "Horizon hit-rate", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 8, wrShow, text_color=wrCol, text_size=hudSz)
    // vote margin meter — how lopsided the neighbor pools are
    table.cell(hud, 0, 9, "Margin", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 9, str.tostring(margin, "#.0") + "% " + barGlyph(margin, 10),
         text_color=margin >= marginMin ? C_ACC : C_FLAT, text_size=hudSz)
    gateReason = not featuresReady ? "WARMING UP / VOLUME MISSING" : not sessOK ? "OUTSIDE CASH SESSION" : not rngOK ? "RANGE TOO SMALL" : not confOK ? (margin < marginMin ? "VOTE POOL TIED" : "WAIT FOR CONFIDENCE") : cooling ? "COOLDOWN ACTIVE" : "READY · CLOSED BAR"
    table.cell(hud, 0, 10, "Signal gate", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 10, gateReason, text_color=confOK and sessOK and rngOK and not cooling ? C_BULL : C_ACC, text_size=hudSz)
    table.cell(hud, 0, 11, "Library / audit", text_color=C_FLAT, text_size=hudSz)
    table.cell(hud, 1, 11, str.tostring(array.size(sampleL)) + "/" + str.tostring(lookback) + " · last " + str.tostring(auditN) + " outcomes", text_color=C_ACC, text_size=hudSz)
    table.cell(hud, 0, 12, "Expectancy", text_color=C_FLAT, text_size=hudSz)
    expTxt = na(expMean) ? "—" : (expMean >= 0 ? "+" : "") + str.tostring(expMean, "#.00") + " ×ATR"
    table.cell(hud, 1, 12, expTxt, text_color=na(expMean) ? C_FLAT : expMean > 0 ? C_BULL : C_BEAR, text_size=hudSz)

// ───────────────────────────────── ALERTS ───────────────────────────────────
if evLong
    alert("LOKI ▲ LONG | conf " + str.tostring(conf, "#.0") + "% | margin " + str.tostring(margin, "#.0") +
         "% | pLong " + str.tostring(pLong, "#.0") +
         "% | entry " + str.tostring(close, format.mintick) + " | TP " + str.tostring(nz(tpPx), format.mintick) +
         " | SL " + str.tostring(nz(slPx), format.mintick), alert.freq_once_per_bar_close)
if evShort
    alert("LOKI ▼ SHORT | conf " + str.tostring(conf, "#.0") + "% | margin " + str.tostring(margin, "#.0") +
         "% | pShort " + str.tostring(pShort, "#.0") +
         "% | entry " + str.tostring(close, format.mintick) + " | TP " + str.tostring(nz(tpPx), format.mintick) +
         " | SL " + str.tostring(nz(slPx), format.mintick), alert.freq_once_per_bar_close)
if evExit
    alert("LOKI ■ EXIT/NEUTRAL | price " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if tpHit or slHit
    alert("LOKI bracket: " + (ambiguousHit ? "BOTH touched; intrabar order unknown" : slHit ? "SL touched" : "TP touched") + " | close " + str.tostring(close, format.mintick), alert.freq_all)
alertcondition(tpHit and not slHit, title="LOKI Target touched", message="LOKI target touched — {{close}}")
alertcondition(slHit and not tpHit, title="LOKI Stop touched", message="LOKI stop touched — {{close}}")
alertcondition(ambiguousHit, title="LOKI Both brackets touched", message="LOKI both levels touched; order unknown — {{close}}")

alertcondition(evLong,  title="LOKI Go Long",  message="LOKI Go Long — {{close}}")
alertcondition(evShort, title="LOKI Go Short", message="LOKI Go Short — {{close}}")
alertcondition(evExit,  title="LOKI Exit",     message="LOKI Exit/Neutral — {{close}}")
